# ── Discord ──────────────────────────────────────────
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Comma-separated guild IDs for instant command registration during dev.
# Leave empty in production to register commands globally.
DISCORD_DEV_GUILD_IDS=

# ── Database ─────────────────────────────────────────
# Local (docker-compose): postgresql://tensura:tensura@localhost:5432/tensura
# Railway: provided automatically as DATABASE_URL by the Postgres plugin.
DATABASE_URL=postgresql://tensura:tensura@localhost:5432/tensura

# ── Redis ────────────────────────────────────────────
# Local (docker-compose): redis://localhost:6379
# Railway: provided automatically as REDIS_URL by the Redis plugin.
REDIS_URL=redis://localhost:6379

# ── Runtime ──────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug
# Total shard count. "auto" lets discord.js fetch the recommended count from Discord.
SHARD_COUNT=auto
# Only set when running one shard per Railway service replica.
SHARD_ID=

# ── AI Assistant (Phase 10) ──────────────────────────
ANTHROPIC_API_KEY=

# ── Anime integration (Phase 9) ──────────────────────
ANILIST_API_URL=https://graphql.anilist.co

# ── XP Config ────────────────────────────────────────
XP_COOLDOWN_SECONDS=
XP_MIN=
XP_MAX=
